# Runtime mode and HTTP server
NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL. In Dokploy, use the database service's internal hostname and port 5432.
DATABASE_URL=postgresql://supercampus:change-me@postgres-service:5432/supercampus
DATABASE_SSL=disable
PGPOOL_MAX=10

# Generate a unique value of at least 32 characters; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-production-secret