{
  "name": "supercampus-web-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "npm install",
    "doctor": "node scripts/check-setup.mjs",
    "dev": "npm run dev --workspace @supercampus/platform",
    "build": "npm run build --workspace @supercampus/platform",
    "start": "npm run start --workspace @supercampus/platform",
    "lint": "npm run lint --workspace @supercampus/platform",
    "test": "npm run test --workspaces --if-present",
    "test:auth": "npm run test:auth --workspace @supercampus/platform",
    "typecheck:packages": "tsc -p tsconfig.packages.json",
    "validate:modules": "node tooling/validate-module/index.mjs",
    "verify": "npm run validate:modules && npm run typecheck:packages && npm run lint && npm run build && npm run test",
    "api:coverage": "node tooling/api-coverage.mjs"
  }
}
