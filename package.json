{
  "name": "supercampus-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "npm install && npm --prefix backend install",
    "doctor": "node scripts/check-setup.mjs",
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm --prefix backend run dev",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:verify": "npm --prefix backend run db:verify",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:backend": "npm --prefix backend test",
    "verify": "npm run lint && npm run build && npm run test:backend"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}